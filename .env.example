# Copy to .env.local (git-ignored) and fill in from https://dashboard.emailjs.com
# Without these the contact form falls back to opening the visitor's email app.
# The EmailJS template uses {{name}}, {{email}}, {{title}}, {{message}}, {{time}} (see src/lib/sendMessage.ts).
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
